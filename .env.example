# ============================================
# DRESSVINTAGE — environment variables
# ============================================
# Copy this file to .env.local for local development.
# In production, set these in the Vercel project dashboard
# (Settings → Environment Variables).
#
# NEVER commit .env.local or any real values to git.

# ---- Supabase ----
# Project URL — from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Public anon key — safe to ship in the browser bundle (RLS-gated)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...PUBLIC_ANON_KEY

# Service role key — SERVER ONLY. Bypasses RLS. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...SERVICE_ROLE_KEY

# ---- Resend (transactional email) ----
# Account API key — from resend.com/api-keys. SERVER ONLY.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# "From" email — must be on a verified domain in Resend
RESEND_FROM_EMAIL=no-reply@dressvintage.com.ar

# Display name shown in the "From" header (optional)
RESEND_FROM_NAME=DressVintage

# Where to send internal "new order" notifications
ADMIN_ORDERS_EMAIL=ventas@dressvintage.com.ar

# Where to send contact / reply emails (Reply-To header)
REPLY_TO_EMAIL=contacto@dressvintage.com.ar

# ---- Site / Public URLs ----
# Used in email CTAs and unsubscribe links. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://dressvintage.com.ar

# ---- Bank info (shown in transferencia emails) ----
BANK_ACCOUNT_HOLDER=Tu Nombre o Razón Social
BANK_ACCOUNT_CBU=0000003100000000000000
BANK_ACCOUNT_ALIAS=dressvintage.mp
BANK_ACCOUNT_CUIT=20-12345678-9

# ---- Social / contact (shown in email footer) ----
WHATSAPP_CONTACT=+5491112345678
INSTAGRAM_URL=https://instagram.com/dressvintage

# ---- Admin protection ----
# Shared secret to gate /api/orders/update-status (until you wire real auth).
# Generate with: openssl rand -base64 32
ADMIN_API_SECRET=replace-with-a-long-random-secret
